- **关键代码 `base.py`**：
  ```python
  from typing import Protocol
  from dataclasses import dataclass, field
  from abc import abstractmethod

  @dataclass
  class SkillResult:
      success: bool
      data: dict = field(default_factory=dict)
      error: str | None = None

  class Skill(Protocol):
      name: str
      description: str
      input_schema: dict
      requires_llm: bool

      @abstractmethod
      async def execute(self, **kwargs) -> SkillResult:
          ...
  ```
- **关键代码 `word_counter.py`**：
  ```python
  from .base import Skill, SkillResult

  class WordCounterSkill:
      name = "word_counter"
      description = "统计文本字数（中英文混合）"
      input_schema = {
          "type": "object",
          "properties": {
              "text": {"type": "string", "description": "要统计的文本"}
          },
          "required": ["text"]
      }
      requires_llm = False

      async def execute(self, text: str) -> SkillResult:
          chinese = sum(1 for c in text if '\u4e00' <= c <= '\u9fff')
          english = len([w for w in text.split() if w.isascii()])
          return SkillResult(
              success=True,
              data={"chinese_chars": chinese, "english_words": english, "total": chinese + english}
          )
  ```

