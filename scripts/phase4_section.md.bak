- **关键代码 `novel_detector.py`**：
  ```python
  import re
  from pathlib import Path
  from dataclasses import dataclass

  CHAPTER_PATTERNS = [
      re.compile(r"第[一二三四五六七八九十百千万\d]+章\s*[^\n]*"),
      re.compile(r"Chapter\s*\d+", re.IGNORECASE),
  ]

  @dataclass
  class DetectedNovel:
      dir_path: str
      title: str
      chapter_count: int
      total_words: int
      chapters: list[dict]  # [{"title": ..., "path": ..., "word_count": ...}]

  class NovelDetector:
      def is_novel_dir(self, path: str) -> bool:
          p = Path(path)
          if not p.is_dir():
              return False

          md_files = list(p.glob("*.md"))
          if len(md_files) < 3:
              return False

          # 检查文件命名
          for f in md_files[:5]:
              content = f.read_text(encoding="utf-8", errors="ignore")[:500]
              if any(p.search(content) for p in CHAPTER_PATTERNS):
                  return True

          return False

      def extract_metadata(self, path: str) -> DetectedNovel:
          p = Path(path)
          md_files = sorted(p.glob("*.md"))

          chapters = []
          total_words = 0
          for f in md_files:
              content = f.read_text(encoding="utf-8", errors="ignore")
              words = len(content)
              total_words += words

              # 提取章节标题
              title = f.stem
              for pattern in CHAPTER_PATTERNS:
                  match = pattern.search(content[:200])
                  if match:
                      title = match.group(0)
                      break

              chapters.append({
                  "title": title,
                  "path": str(f.absolute()),
                  "word_count": words,
              })

          return DetectedNovel(
              dir_path=str(p.absolute()),
              title=p.name,
              chapter_count=len(md_files),
              total_words=total_words,
              chapters=chapters,
          )
  ```
- **用户人工**：配置扫描目录 → 启动扫描 → 看到结果 → 确认导入

