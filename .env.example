# Book Soul 环境变量示例
# ⚠️ 复制本文件为 .env 并填入真实值
# ⚠️ .env 永远不入 git（.gitignore 已排除）
#
# 优先级：环境变量 > .env > config/app.yaml > 代码默认值
#
# 也可以不配 .env —— 打包版在「设置 → LLM 与密钥」里填 Key，
# 走 DPAPI 加密文件存储，明文永不落盘。

# ===== LLM provider =====
# provider 清单与 config/llm.yaml 一一对应；
# 每个 provider 的环境变量名见 llm.yaml 里的 api_key_env 字段。

# mimo —— 默认主用，国内直连免 VPN
# 申请：https://platform.xiaomimimo.com/
MIMO_API_KEY=sk-your-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# minimax —— 备用，海外节点需要 VPN
# 申请：https://platform.minimaxi.com/
MINIMAX_API_KEY=sk-your-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# openai —— 备用
# 申请：https://platform.openai.com/
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ollama —— 本地模型，不需要 Key
# 默认地址，一般无需修改
OLLAMA_BASE_URL=http://localhost:11434/v1

# ===== Skill =====
# web_search 技能用 SerpAPI（其他 11 个内置 Skill 都不需要 Key）
# 申请：https://serpapi.com/
SERPAPI_KEY=your-key-here

# ===== 应用配置 =====
# 后端监听地址（开发模式用；打包版由 Rust 侧分配随机空闲端口）
BOOK_SOUL_HOST=127.0.0.1
BOOK_SOUL_PORT=8765

# 数据目录
#   留空 → 回落到 ~/Documents/BookSoul/
#   开发脚本会覆盖成 <仓库根>/data/dev
#   打包版由 sidecar 传入 <exe 同级>/data
BOOK_SOUL_DATA_DIR=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 内容加密（默认关闭；开启后 ⚠️ 卸载应用 / 重装系统 = 数据无法解密）
ENCRYPTION_ENABLED=false
