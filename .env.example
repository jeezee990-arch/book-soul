# Book Soul 环境变量示例
# ⚠️ 复制本文件为 .env 并填入真实值
# ⚠️ .env 永远不入 git

# ===== minimax（主用 LLM）=====
# 申请：https://api.minimaxi.com/
MINIMAX_API_KEY=sk-your-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ===== OpenAI（备用）=====
# 申请：https://platform.openai.com/
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Anthropic Claude（备用）=====
# 申请：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== Tavily（可选：网络搜索）=====
# 申请：https://tavily.com/
TAVILY_API_KEY=tvly-your-key-here

# ===== LangSmith（可选：调试追踪）=====
# 申请：https://smith.langchain.com/
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===== Ollama（本地 LLM，可选）=====
# 默认本地地址，一般无需修改
OLLAMA_BASE_URL=http://localhost:11434/v1

# ===== 应用配置 =====
# 后端服务地址（一般无需修改）
BOOK_SOUL_HOST=127.0.0.1
BOOK_SOUL_PORT=8765

# 数据目录（一般无需修改，会在用户主目录创建 ~/Documents/BookSoul/）
BOOK_SOUL_DATA_DIR=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 加密（默认关闭；开启后警告用户备份风险）
ENCRYPTION_ENABLED=false
